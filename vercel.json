{
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "npm install && cd frontend && npm install",
  "framework": "vite",
  "devCommand": "cd frontend && npm run dev -- --port $PORT",
  "rewrites": [
    {
      "source": "/((?!api/|@|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
