{
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "npm install && cd frontend && npm install",
  "framework": "vite",
  "devCommand": "cd frontend && npm run dev -- --port $PORT",
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/correos/cron-enviar?secret=cepre-cron-2026-xyz789",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
